import random
quiz=[
    {
        'question': 'What is the capital of France?',
        'options': ['A.Berlin','B.Madrid','C.Paris','D.Rome'],
        'answer':'C'
    },
    {
        'question': 'Which planet is known as red planet?',
        'options': ['A.Earth','B.Mars','C.Neptiun','D.Saturn'],
        'answer':'B'
    },
    {
        'question': 'What is the largest ocean on Earth?',
        'options': ['A.Atlantic','B.India','C.Arctic','D.Pacific'],
        'answer':'D'
    }
]
random.shuffle(quiz)

score=0

for index, item in enumerate(quiz,1):
    print(f'Question {index}: {item['question']}')
    for option in item['options']:
        print(option)
        
    answer=input('Your answer:').upper().strip()
    
    if answer == item['answer']:
        print('Correct!')
        score+=1
    else:
        print(f'Wrong! The correct answer is {item['answer']}')

print(f'Quiz over! Youur final score is {score} out of {len(quiz)}')
